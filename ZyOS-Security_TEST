    <!-- OTHER WINDOWS (Simplified for space) -->
    <div class="win" id="win-monitor" style="left:30%;top:20%;width:400px;height:300px">
        <div class="titlebar" data-drag>SYSTEM MONITOR<div class="spacer"></div><button class="winbtn" onclick="closeWin('monitor')">×</button></div>
        <div class="body"><h3>SESSÃO ATIVA</h3><div class="section">CPU: 14%<br>RAM: 2.1GB<br>STATUS: <span class="green">ENCRYPTED</span></div></div>
    </div>
    <div class="win" id="win-notes" style="left:25%;top:25%;width:500px;height:350px">
        <div class="titlebar" data-drag>ZY-NOTES<div class="spacer"></div><button class="winbtn" onclick="closeWin('notes')">×</button></div>
        <div class="body"><textarea id="notes" style="width:100%; height:200px; background:#000; color:#fff; border:1px solid #333; padding:10px; outline:none; font:inherit; resize:none;" placeholder="// Anote seus payloads aqui..."></textarea><br><button class="action" onclick="saveNotes()">SALVAR</button></div>
    </div>
    <div class="win" id="win-about" style="left:30%;top:15%;width:400px;height:300px">
        <div class="titlebar" data-drag>ABOUT ZYOS<div class="spacer"></div><button class="winbtn" onclick="closeWin('about')">×</button></div>
        <div class="body"><h3>ZyOS Intelligence Edition</h3><p>Interface focada em documentação de Cybersecurity. Inspirada no BlackArch Linux.</p><p class="orange">By Zybyte_retr0</p></div>
    </div>

    <div id="menu">
        <h3 style="color:var(--orange); font-family:Orbitron">ZYOS MENU</h3>
        <div class="menuitem" onclick="openWin('terminal');toggleMenu()">›_ Terminal</div>
        <div class="menuitem" onclick="openWin('tools');toggleMenu()">⌘ Security Toolkit</div>
        <div class="menuitem" onclick="openWin('library');toggleMenu()">◈ Cyber Library</div>
        <div class="menuitem" onclick="openWin('monitor');toggleMenu()">▥ System Monitor</div>
        <div class="menuitem" onclick="openWin('notes');toggleMenu()">✎ Notas</div>
