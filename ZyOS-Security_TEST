    </div>
    <div class="win" id="win-about" style="left:30%;top:15%;width:400px;height:300px">
        <div class="titlebar" data-drag>ABOUT ZYOS<div class="spacer"></div><button class="winbtn" type="button" aria-label="Minimizar" title="Minimizar" onclick="minimizeWin('about')">−</button><button class="winbtn" type="button" aria-label="Maximizar ou restaurar" title="Maximizar / restaurar" onclick="maximizeWin('about')">□</button><button class="winbtn" type="button" aria-label="Fechar" title="Fechar" onclick="closeWin('about')">×</button></div>
        <div class="body"><h3>ZyOS Intelligence Edition</h3><p>Interface focada em documentação de Cybersecurity. Inspirada no BlackArch Linux.</p><p class="orange">By Zybyte_retr0</p></div>
    </div>

    <div id="menu">
        <h3 style="color:var(--orange); font-family:Orbitron">ZYOS MENU</h3>
        <div class="menuitem" onclick="openWin('terminal');toggleMenu()">›_ Terminal</div>
        <div class="menuitem" onclick="openWin('tools');toggleMenu()">⌘ Security Toolkit</div>
        <div class="menuitem" onclick="openWin('library');toggleMenu()">◈ Cyber Library</div>
        <div class="menuitem" onclick="openWin('monitor');toggleMenu()">▥ System Monitor</div>
        <div class="menuitem" onclick="openWin('notes');toggleMenu()">✎ Notas</div>
        <div class="menuitem" onclick="openWin('study');toggleMenu()">▤ Central de Estudos</div>
        <div class="menuitem" onclick="location.reload()">⟲ Reiniciar</div>
    </div>

    <div id="taskbar">
        <button id="start" onclick="toggleMenu()">ZyOS</button>
        <button class="taskapp" onclick="openWin('terminal')">TERMINAL</button>
        <button class="taskapp" onclick="openWin('tools')">TOOLKIT</button>
        <button class="taskapp" onclick="openWin('library')">LIBRARY</button>
        <button class="taskapp" onclick="openWin('study')">ESTUDOS</button>
        <div id="taskclock" class="right"><span id="tbtime">--:--</span></div>
    </div>
</div>

<script>
    // BOOT
    const bootLines = ['> initializing zy_core.intel ...', '> loading cyber_library modules ...', '> mounting encrypted workspace ...', '> bypassing security filters ...', '> ZyOS Intelligence Ready.'];
    const blog = document.getElementById('bootlog');
    let bi = 0;
    const bootTimer = setInterval(() => {
        if (bi < bootLines.length) { blog.textContent += bootLines[bi++] + '\n'; } else { clearInterval(bootTimer); }
    }, 350);
    setTimeout(() => document.getElementById('boot').classList.add('off'), 2500);

    // GERENCIADOR DE JANELAS: abrir, fechar, minimizar, maximizar e restaurar
    let zTop = 100;
    const windowRects = new WeakMap();
    function focusWin(w) { w.style.zIndex = ++zTop; }
    function openWin(id) {
        const w = document.getElementById('win-' + id);
        if (!w) return;
        w.classList.remove('minimized');
        w.classList.add('open');
        focusWin(w);
        document.getElementById('menu')?.classList.remove('open');
    }
    function closeWin(id) {
        const w = document.getElementById('win-' + id);
        if (!w) return;
        w.classList.remove('open', 'minimized', 'maximized');
        windowRects.delete(w);
    }
    function minimizeWin(id) {
        const w = document.getElementById('win-' + id);
        if (!w) return;
        w.classList.remove('maximized');
        w.classList.add('minimized');
    }
    function maximizeWin(id) {
        const w = document.getElementById('win-' + id);
        if (!w) return;
        if (!w.classList.contains('maximized')) {
            const r = w.getBoundingClientRect();
            windowRects.set(w, { left: r.left, top: r.top, width: r.width, height: r.height });
            w.classList.add('maximized');
        } else {
            w.classList.remove('maximized');
            const r = windowRects.get(w);
            if (r) {
                w.style.left = Math.max(0, Math.min(r.left, window.innerWidth - 300)) + 'px';
                w.style.top = Math.max(34, Math.min(r.top, window.innerHeight - 200)) + 'px';
                w.style.width = Math.min(r.width, window.innerWidth) + 'px';
                w.style.height = Math.min(r.height, window.innerHeight - 46) + 'px';
            }
        }
        focusWin(w);
    }
    function toggleMenu() { document.getElementById('menu')?.classList.toggle('open'); }

    // Arrastar janela sem capturar cliques nos botões da barra de título
    let dragState = null;
    document.querySelectorAll('[data-drag]').forEach(bar => {
        const win = bar.parentElement;
        bar.addEventListener('pointerdown', e => {
            if (e.target.closest('button') || win.classList.contains('maximized') || e.button !== 0) return;
            const r = win.getBoundingClientRect();
            dragState = { win, dx: e.clientX - r.left, dy: e.clientY - r.top, pointerId: e.pointerId };
            focusWin(win);
            if (bar.setPointerCapture) bar.setPointerCapture(e.pointerId);
        });
        bar.addEventListener('pointermove', e => {
            if (!dragState || dragState.win !== win || dragState.pointerId !== e.pointerId) return;
            const maxLeft = Math.max(0, window.innerWidth - 120);
            const maxTop = Math.max(34, window.innerHeight - 80);
            win.style.left = Math.max(0, Math.min(e.clientX - dragState.dx, maxLeft)) + 'px';
            win.style.top = Math.max(34, Math.min(e.clientY - dragState.dy, maxTop)) + 'px';
        });
        const stopDrag = e => { if (dragState && dragState.win === win && (!e || dragState.pointerId === e.pointerId)) dragState = null; };
        bar.addEventListener('pointerup', stopDrag);
        bar.addEventListener('pointercancel', stopDrag);
        bar.addEventListener('lostpointercapture', stopDrag);
    });
    document.querySelectorAll('.win').forEach(w => w.addEventListener('pointerdown', () => focusWin(w)));

    // TERMINAL INTELLIGENCE
    const termout = document.getElementById('termout');
    const termin = document.getElementById('termin');
    function printLine(s = '') {
        termout.textContent += s + '\n';
        document.getElementById('term-body').scrollTop = termout.scrollHeight;
    }
    function runCommand(raw) {
        const c = raw.trim(), lc = c.toLowerCase();
        if (!c) return;
        printLine('root@zyos:~$ ' + c);
        
        if (lc === 'help') {
            printLine('--- COMANDOS DE INTELIGÊNCIA ---');
            printLine('ls -l          : Lista diretórios de manuais');
            printLine('nmap -sV       : Exemplo de scan de versão');
            printLine('hashcat -m 0    : Exemplo de crack de MD5');
            printLine('open library   : Abre o Dossiê de Cyber');
            printLine('open tools     : Abre o Toolkit de Hardware');
            printLine('clear          : Limpa a tela');
        } else if (lc === 'clear') {
            termout.textContent = '';
        } else if (lc === 'ls -l') {
            printLine('drwxr-xr-x  /root/manuals/pentest');
            printLine('drwxr-xr-x  /root/manuals/rfid_nfc');
            printLine('drwxr-xr-x  /root/manuals/social_eng');
            printLine('-rw-r--r--  /root/payloads.txt');
        } else if (lc.includes('nmap')) {
            printLine('Sintaxe: nmap [Scan Type] [Options] {target}');
            printLine('Ex: nmap -sS -sV -O 192.168.1.1');
        } else if (lc.includes('hashcat')) {
            printLine('Sintaxe: hashcat -m [Hash Type] -a [Attack Mode] [Hash File] [Wordlist]');
            printLine('Ex: hashcat -m 0 -a 0 hashes.txt rockyou.txt');
        } else if (lc.startsWith('open ')) {
            const app = lc.replace('open ', '').trim();
            openWin(app);
            printLine('Acessando módulo ' + app + '...');
        } else {
            printLine('Erro: Comando não reconhecido ou sem privilégios.');
        }
        printLine('');
    }
    termin.addEventListener('keydown', e => { if (e.key === 'Enter') { runCommand(termin.value); termin.value = ''; } });

    // CLOCK
    function tick() {
        const d = new Date();
        document.getElementById('tbtime').textContent = d.getHours().toString().padStart(2,'0') + ':' + d.getMinutes().toString().padStart(2,'0');
        document.getElementById('topdate').textContent = d.toLocaleDateString('pt-BR').toUpperCase();
    }
    setInterval(tick, 1000); tick();

    function saveNotes() { alert('Notas salvas no buffer local.'); }

    // ZY-STUDY: matérias, trilhas e conteúdos persistidos no navegador
    const STUDY_STORAGE_KEY = 'zyos-study-items-v1';
    let studyItems = [];
    let editingStudyId = null;
    try {
        const savedStudy = JSON.parse(localStorage.getItem(STUDY_STORAGE_KEY) || '[]');
        if (Array.isArray(savedStudy)) studyItems = savedStudy;
    } catch (e) { console.warn('Não foi possível ler os dados de estudo salvos.', e); }

    function persistStudy() {
        try {
            localStorage.setItem(STUDY_STORAGE_KEY, JSON.stringify(studyItems));
            renderStudyItems();
        } catch (e) {
            alert('Não foi possível salvar os estudos no navegador. Exporte os dados e verifique o espaço disponível.');
        }
    }
    function escapeStudyHtml(value) {
        return String(value ?? '').replace(/[&<>"']/g, ch => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch]));
    }
    function renderStudyItems() {
        const query = document.getElementById('study-search').value.trim().toLowerCase();
        const type = document.getElementById('study-filter').value;
        const status = document.getElementById('study-status').value;
        const filtered = studyItems.filter(item => {
            const matchesText = [item.title, item.subject, item.description, item.type].join(' ').toLowerCase().includes(query);
            return matchesText && (type === 'Todos' || item.type === type) &&
                (status === 'Todos' || (status === 'Concluído' ? item.done : !item.done));
        });
        const total = studyItems.length, done = studyItems.filter(item => item.done).length;
        document.getElementById('study-total').textContent = total;
        document.getElementById('study-done').textContent = done;
        document.getElementById('study-progress').textContent = (total ? Math.round(done / total * 100) : 0) + '%';
        const list = document.getElementById('study-list');
        if (!filtered.length) {
            list.innerHTML = '<div class="study-empty">' + (studyItems.length ? 'Nenhum resultado para estes filtros.' : 'Nenhum item ainda. Use o formulário para criar seu primeiro plano.') + '</div>';
            return;
        }
        const typeOrder = {'Matéria':0, 'Trilha':1, 'Conteúdo':2};
        filtered.sort((a,b) => (typeOrder[a.type] ?? 3) - (typeOrder[b.type] ?? 3) || a.title.localeCompare(b.title, 'pt-BR'));
        list.innerHTML = filtered.map(item => `
            <article class="study-item ${item.done ? 'done' : ''}">
                <div class="meta">${escapeStudyHtml(item.type.toUpperCase())} · ${item.done ? '<span style="color:var(--green)">CONCLUÍDO</span>' : 'PENDENTE'}</div>
                <h4>${escapeStudyHtml(item.title)}</h4>
                ${item.subject ? `<div class="meta">RELACIONADO A: ${escapeStudyHtml(item.subject)}</div>` : ''}
                ${item.description ? `<p>${escapeStudyHtml(item.description)}</p>` : ''}
                <div class="study-actions">
                    <button class="action" type="button" onclick="toggleStudyDone('${item.id}')">${item.done ? '↶ REABRIR' : '✓ CONCLUIR'}</button>
                    <button class="action" type="button" onclick="editStudyItem('${item.id}')">EDITAR</button>
                    <button class="action" type="button" onclick="deleteStudyItem('${item.id}')">EXCLUIR</button>
                </div>
            </article>`).join('');
    }
    document.getElementById('study-form').addEventListener('submit', event => {
        event.preventDefault();
        const title = document.getElementById('study-title').value.trim();
        if (!title) return;
        const values = {
            type: document.getElementById('study-type').value,
            title,
            subject: document.getElementById('study-subject').value.trim(),
            description: document.getElementById('study-description').value.trim()
        };
        if (editingStudyId) {
            const item = studyItems.find(entry => entry.id === editingStudyId);
            if (item) Object.assign(item, values);
        } else {
            studyItems.push({ id: (crypto.randomUUID ? crypto.randomUUID() : String(Date.now()) + Math.random().toString(16).slice(2)), ...values, done:false, createdAt:new Date().toISOString() });
        }
        document.getElementById('study-form').reset();
        cancelStudyEdit();
        persistStudy();
    });
    function toggleStudyDone(id) {
        const item = studyItems.find(entry => entry.id === id);
        if (item) { item.done = !item.done; persistStudy(); }
    }
    function editStudyItem(id) {
        const item = studyItems.find(entry => entry.id === id);
        if (!item) return;
        editingStudyId = id;
        document.getElementById('study-type').value = item.type;
        document.getElementById('study-title').value = item.title;
        document.getElementById('study-subject').value = item.subject || '';
        document.getElementById('study-description').value = item.description || '';
        document.getElementById('study-form-title').textContent = 'EDITAR ITEM DE ESTUDO';
        document.getElementById('study-submit').textContent = 'SALVAR ALTERAÇÕES';
        document.getElementById('study-cancel').hidden = false;
        document.getElementById('study-title').focus();
    }
    function cancelStudyEdit() {
        editingStudyId = null;
        document.getElementById('study-form-title').textContent = 'ADICIONAR CONTEÚDO';
        document.getElementById('study-submit').textContent = '＋ ADICIONAR À MINHA TRILHA';
        document.getElementById('study-cancel').hidden = true;
    }
    function deleteStudyItem(id) {
        const item = studyItems.find(entry => entry.id === id);
        if (item && confirm('Excluir "' + item.title + '" dos estudos?')) {
            studyItems = studyItems.filter(entry => entry.id !== id);
            if (editingStudyId === id) { document.getElementById('study-form').reset(); cancelStudyEdit(); }
            persistStudy();
        }
    }
    function exportStudyData() {
        const blob = new Blob([JSON.stringify(studyItems, null, 2)], {type:'application/json'});
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url; a.download = 'zyos-estudos-backup.json'; a.click();
        URL.revokeObjectURL(url);
    }
    document.getElementById('study-import').addEventListener('change', async event => {
        const file = event.target.files[0];
        if (!file) return;
        try {
            const parsed = JSON.parse(await file.text());
            if (!Array.isArray(parsed) || parsed.some(item => !item || typeof item.title !== 'string' || !['Matéria','Trilha','Conteúdo'].includes(item.type))) {
                throw new Error('Formato inválido');
            }
            if (confirm('Importar vai substituir todos os itens atuais. Deseja continuar?')) {
                studyItems = parsed.map(item => ({
                    id: String(item.id || (Date.now() + Math.random())),
                    type: item.type, title: item.title, subject: String(item.subject || ''),
                    description: String(item.description || ''), done: Boolean(item.done),
                    createdAt: item.createdAt || new Date().toISOString()
                }));
                persistStudy();
            }
        } catch (error) { alert('Arquivo JSON inválido ou incompatível. Nenhum dado foi importado.'); }
        event.target.value = '';
    });
    ['study-search','study-filter','study-status'].forEach(id =>
        document.getElementById(id).addEventListener(id === 'study-search' ? 'input' : 'change', renderStudyItems)
    );
    renderStudyItems();
</script>
</body>
</html>
