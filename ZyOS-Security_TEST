    <div class="win" id="win-notes" style="left:25%;top:25%;width:500px;height:350px">
        <div class="titlebar" data-drag>ZY-NOTES<div class="spacer"></div><button class="winbtn" type="button" aria-label="Minimizar" title="Minimizar" onclick="minimizeWin('notes')">−</button><button class="winbtn" type="button" aria-label="Maximizar ou restaurar" title="Maximizar / restaurar" onclick="maximizeWin('notes')">□</button><button class="winbtn" type="button" aria-label="Fechar" title="Fechar" onclick="closeWin('notes')">×</button></div>
