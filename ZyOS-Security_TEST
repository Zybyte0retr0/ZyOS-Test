    <!-- SECURITY TOOLKIT -->
    <div class="win" id="win-tools" style="left:25%;top:10%;width:700px;height:500px">
        <div class="titlebar" data-drag>SECURITY TOOLKIT <div class="spacer"></div><button class="winbtn" type="button" title="Minimizar" onclick="minimizeWin('tools')">−</button><button class="winbtn" type="button" title="Maximizar / restaurar" onclick="maximizeWin('tools')">□</button><button class="winbtn" type="button" title="Fechar" onclick="closeWin('tools')">×</button></div>
