    <div class="win" id="win-library" style="left:20%;top:10%;width:800px;height:550px">
        <div class="titlebar" data-drag>CYBER-LIBRARY // DOSSIÊ <div class="spacer"></div><button class="winbtn" onclick="minimizeWin('library')">−</button><button class="winbtn" onclick="maximizeWin('library')">□</button><button class="winbtn" onclick="closeWin('library')">×</button></div>
        <div class="body">
