    </div>

    <!-- CYBER LIBRARY -->
    <div class="win" id="win-library" style="left:20%;top:10%;width:800px;height:550px">
        <div class="titlebar" data-drag>CYBER-LIBRARY // DOSSIÊ <div class="spacer"></div><button class="winbtn" type="button" title="Minimizar" onclick="minimizeWin('library')">−</button><button class="winbtn" type="button" title="Maximizar / restaurar" onclick="maximizeWin('library')">□</button><button class="winbtn" type="button" title="Fechar" onclick="closeWin('library')">×</button></div>
        <div class="body">
