<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ZyOS — Cyber Intelligence Edition</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Orbitron:wght@500;700;900&display=swap');
        :root {
            --orange: #ff6a00; --orange2: #ff9b45; --bg: #050608; --panel: #0d0e13; 
            --panel2: #15171e; --line: #30333c; --silver: #aeb4be; --muted: #777e8b; 
            --green: #65ff9a; --red: #ff555d; --blue: #65c8ff;
        }
        * { box-sizing: border-box; }
        body { margin: 0; background: var(--bg); color: var(--silver); font: 13px 'Share Tech Mono', monospace; overflow: hidden; height: 100vh; }
        
        /* BOOT */
        #boot { position: fixed; inset: 0; z-index: 1000; background: radial-gradient(ellipse at 50% 42%, #19110b, #050507 65%); display: flex; align-items: center; justify-content: center; flex-direction: column; transition: opacity .7s; }
        #boot.off { opacity: 0; pointer-events: none; }
        .logo { font: 900 clamp(42px, 8vw, 82px) Orbitron, sans-serif; letter-spacing: 10px; color: var(--orange); text-shadow: 0 0 30px #ff6a0066; }
        .logo span { color: #ddd; }
        .boot-sub { color: var(--muted); letter-spacing: 4px; margin-top: 12px; font-size: 10px; }
        .boot-bar { width: min(340px, 75vw); height: 5px; background: #24252b; margin: 28px 0 16px; overflow: hidden; border: 1px solid #343841; }
        .boot-bar:after { content: ""; display: block; height: 100%; background: var(--orange); animation: load 2.4s ease forwards; box-shadow: 0 0 16px var(--orange); }
        @keyframes load { to { width: 100%; } }
        #bootlog { font-size: 11px; line-height: 1.8; color: #9aa1ac; text-align: left; min-height: 78px; width: min(360px, 80vw); }

        /* DESKTOP */
        #desktop { position: fixed; inset: 0 0 46px; background: radial-gradient(ellipse at 51% 46%, #ff6a0015 0%, transparent 44%), linear-gradient(135deg, #08090c 0%, #0b0c10 45%, #050608 100%); animation: flicker 8s infinite; }
        #desktop:before { content: ""; position: absolute; inset: 0; pointer-events: none; background-image: linear-gradient(#ff6a0009 1px, transparent 1px), linear-gradient(90deg, #ff6a0009 1px, transparent 1px); background-size: 32px 32px; }
        @keyframes flicker { 0%, 96%, 100% { opacity: 1; } 97% { opacity: .86; } 98% { opacity: .96; } }
        .watermark { position: absolute; left: 50%; top: 48%; transform: translate(-50%, -50%); font: 900 clamp(70px, 13vw, 150px) Orbitron; color: #ff6a0007; letter-spacing: 15px; pointer-events: none; }

        /* UI ELEMENTS */
        .topbar { position: absolute; z-index: 100; top: 0; left: 0; right: 0; height: 34px; display: flex; align-items: center; gap: 18px; padding: 0 16px; background: linear-gradient(90deg, #090a0df5, #15171bf0, #090a0df5); border-bottom: 1px solid #ff6a0070; color: #8e949f; }
        .topbar strong { color: var(--orange); font-family: Orbitron; letter-spacing: 2px; }
        .topbar .right { margin-left: auto; }
        .author-seal { display: inline-flex; align-items: center; gap: 7px; border: 1px solid #8f969f; background: linear-gradient(135deg, #24272d, #0b0c10); padding: 4px 8px; color: #e3e6eb; font: 700 9px Orbitron; clip-path: polygon(0 0, calc(100% - 7px) 0, 100% 7px, 100% 100%, 7px 100%, 0 calc(100% - 7px)); }
        .seal-dot { width: 7px; height: 7px; background: var(--orange); border-radius: 50%; box-shadow: 0 0 10px var(--orange); }

        .shortcuts { position: absolute; z-index: 3; top: 67px; left: 42px; display: grid; gap: 9px; }
        .shortcut { width: 82px; min-height: 76px; text-align: center; padding: 8px 4px; border: 1px solid #ffffff08; cursor: pointer; color: #c6cad2; background: linear-gradient(135deg, #14161b77, #090a0d22); transition: 0.2s; }
        .shortcut:hover { background: #ff6a0019; border-color: #ff6a0077; box-shadow: 0 0 18px #ff6a0010; }
        .shortcut .ico { width: 40px; height: 40px; margin: 0 auto 7px; border: 1px solid #aeb4be; display: grid; place-items: center; font-size: 18px; color: var(--orange); background: linear-gradient(145deg, #1d2026, #090a0c); clip-path: polygon(0 0, 100% 0, 100% 78%, 78% 100%, 0 100%); }
        .shortcut small { font-size: 10px; display: block; }

        /* WINDOWS */
        .win { display: none; position: absolute; z-index: 10; min-width: 300px; min-height: 200px; background: linear-gradient(145deg, #101116fa, #090a0efc); border: 1px solid #777e887a; box-shadow: 0 0 0 1px #ff6a001f, 0 24px 70px #000d; border-radius: 3px; overflow: hidden; resize: both; }
        .win.open { display: flex; flex-direction: column; }
        .win.maximized { left: 8px !important; top: 42px !important; width: calc(100vw - 16px) !important; height: calc(100dvh - 98px) !important; resize: none !important; }
        .titlebar { height: 39px; display: flex; align-items: center; gap: 9px; padding: 0 11px; background: linear-gradient(90deg, #ff6a0025, #17191f 48%, #0b0c10); border-bottom: 1px solid #ff6a0080; cursor: grab; color: var(--orange2); font: 700 11px Orbitron; }
        .titlebar .spacer { flex: 1; }
        .winbtn { width: 24px; height: 23px; background: transparent; border: 1px solid #555963; color: #c7cbd2; cursor: pointer; }
        .winbtn:hover { background: var(--orange); color: #111; }
        .body { padding: 14px; overflow: auto; flex: 1; line-height: 1.6; }
        .body h3 { color: var(--orange); font: 700 13px Orbitron; margin-top: 0; }
        .section { border: 1px solid #393d46; background: linear-gradient(135deg, #12141a, #090a0e); padding: 12px; margin: 8px 0; }
        .action { border: 1px solid var(--orange); background: #ff6a0010; color: var(--orange2); padding: 7px 10px; cursor: pointer; transition: 0.2s; }
        .action:hover { background: var(--orange); color: #111; }
        .pill { display: inline-block; border: 1px solid #424650; padding: 2px 7px; color: #bfc4ce; font-size: 10px; margin: 2px; }
        .pill.red { border-color: var(--red); color: var(--red); }
        .pill.blue { border-color: var(--blue); color: var(--blue); }
        .pill.green { border-color: var(--green); color: var(--green); }

        /* TERMINAL */
        #termout { white-space: pre-wrap; color: #ffb36c; }
        .termrow { display: flex; gap: 8px; margin-top: 8px; }
        .prompt { color: var(--orange); }
        #termin { flex: 1; background: transparent; border: 0; border-bottom: 1px solid #3b3e46; color: #ffe0bf; outline: none; font: inherit; }

        /* TASKBAR */
        #taskbar { position: fixed; z-index: 200; bottom: 0; left: 0; right: 0; height: 46px; background: linear-gradient(90deg, #090a0df7, #17191ef7, #090a0df7); border-top: 1px solid #ff6a0088; display: flex; align-items: center; gap: 8px; padding: 0 12px; }
        #start { border: 0; background: var(--orange); color: #08090c; font: 900 11px Orbitron; padding: 9px 18px; cursor: pointer; clip-path: polygon(6px 0, 100% 0, calc(100% - 6px) 100%, 0 100%); }
        .taskapp { border: 1px solid #454952; color: #c3c7cf; background: #111319; padding: 6px 10px; font-size: 10px; cursor: pointer; }
        .taskapp:hover { border-color: var(--orange); color: var(--orange); }
        #taskclock { margin-left: auto; color: #c3c7cf; font-size: 12px; }

        /* MENU */
        #menu { display: none; position: fixed; z-index: 300; bottom: 54px; left: 10px; width: 265px; padding: 14px; background: linear-gradient(145deg, #17191f, #08090c); border: 1px solid #8d949e; }
        #menu.open { display: block; }
        .menuitem { padding: 10px; cursor: pointer; border-left: 2px solid transparent; transition: 0.2s; }
        .menuitem:hover { background: #ff6a0012; border-left-color: var(--orange); color: var(--orange); }

        /* CYBER LIBRARY GRID */
        .cyber-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 15px; }
        .cyber-card { background: #0a0b0f; border: 1px solid #30333b; padding: 15px; border-radius: 4px; }
        .cyber-card h4 { color: var(--orange); margin: 0 0 10px 0; font-family: Orbitron; font-size: 12px; }
        .cyber-card code { display: block; background: #000; color: var(--green); padding: 5px; font-size: 11px; margin: 5px 0; border-left: 2px solid var(--green); }

        @media(max-width:650px){
            .shortcuts { left: 18px; grid-template-columns: repeat(2, 75px); }
            .win { left: 4% !important; top: 8% !important; width: 92% !important; height: 80% !important; }
        }
    </style>
</head>
<body>

